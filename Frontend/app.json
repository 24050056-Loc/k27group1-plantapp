{
  "expo": {
    "name": "Plantify",
    "slug": "plantify",
    "scheme": "plantify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoPlantApp.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/LogoPlantApp.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để đổi ảnh đại diện.",
          "cameraPermission": "Ứng dụng cần quyền dùng camera để chụp ảnh đại diện."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/LogoPlantApp.png",
          "color": "#2E7D32",
          "defaultChannel": "plant-care",
          "androidMode": "default",
          "androidCollapsedTitle": "PlantApp 🌿"
        }
      ],
      "expo-build-properties",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/LogoPlantApp.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.TNMT.PlantApp"
    },
    "web": {
      "favicon": "./assets/LogoPlantApp.png"
    },
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "fdf0b277-7f4f-4a92-bdef-66bbd1a38f47"
      }
    }
  }
}
